# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.env/
venv/
.pytest_cache/
.ruff_cache/

# Data, checkpoints and caches (never committed)
data/raw/*
data/processed/*
data/cache/*
checkpoints/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
!checkpoints/.gitkeep

# Large generated results (selected small figures live in assets/)
results/metrics/*
results/plots/*
results/examples/*
!results/*/.gitkeep

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*:Zone.Identifier

# Official third-party code cloned for model loading (not vendored)
external/

# Model weights are never committed (licences: DINOv2 Apache-2.0, DINOv3 DINOv3 License,
# I-JEPA CC BY-NC 4.0). Only results are shared.
*.pth
*.pth.tar
*.pt
*.ckpt
*.safetensors
*.bin
checkpoints/
*.url

# Scratch re-runs (compared with results/benchmark before anything is promoted)
results/rerun/
